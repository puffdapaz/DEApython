	/// Format for Returns Nature visualization and analytical interpretation.
	measure RETURNS_NATURE = ```
			
			VAR ReturnsValue = SELECTEDVALUE('public DEA_python'[DEA_returns_nature])
			VAR UserCulture = LEFT(USERCULTURE(), 2)
			
			RETURN
			SWITCH(TRUE(),
			    ReturnsValue = "Decreasing",
			        SWITCH(UserCulture,
			            "en", "Decreasing",
			            "pt", "Decrescente",
			            "Decreasing"
			        ),
			    
			    ReturnsValue = "Increasing",
			        SWITCH(UserCulture,
			            "en", "Increasing",
			            "pt", "Crescente",
			            "Increasing"
			        ),
			    
			    ReturnsValue = "Constant",
			        SWITCH(UserCulture,
			            "en", "Constant",
			            "pt", "Constante",
			            "Constant"
			        ),
			    
			    ""
			)
			```
		lineageTag: bbe65b99-ccb3-4106-9a89-e0b4bc569996

