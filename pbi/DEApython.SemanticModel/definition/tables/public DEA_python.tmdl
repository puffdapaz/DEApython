/// Analytical dataset at the municipality-year grain used as the Decision Making Units (DMUs) for the Data Envelopment Analysis (DEA) model. Each row represents a Brazilian municipality in a specific year.
table 'public DEA_python'
	lineageTag: c1f2c1bc-463e-47e0-a4ed-8492c3743bbf

	measure VRS_Base =
			
			VAR FirstYear =
			    CALCULATE(
			        MIN('public DEA_python'[year]),
			        ALLEXCEPT('public DEA_python', 'public DEA_python'[city_id])
			    )
			RETURN
			CALCULATE(
			    AVERAGE('public DEA_python'[DEA_vrs_input]),
			    'public DEA_python'[year] = FirstYear
			)
		isHidden
		lineageTag: 935702c0-bbaf-4927-a2d2-99b7e0df1bcf

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure VRS_Current =
			
			VAR LastYear =
			    CALCULATE(
			        MAX('public DEA_python'[year]),
			        ALLEXCEPT('public DEA_python', 'public DEA_python'[city_id])
			    )
			RETURN
			CALCULATE(
			    AVERAGE('public DEA_python'[DEA_vrs_input]),
			    'public DEA_python'[year] = LastYear
			)
		isHidden
		lineageTag: 355f41ab-262d-4c4b-be4d-bbf5de2aa63a

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure VRS_Trend =
			
			VAR Delta = [VRS_Delta]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Delta), BLANK(),
			        Delta > 0, "↑",  // Or UNICHAR(9650) for ▲
			        Delta < 0, "↓",  // Or UNICHAR(9660) for ▼
			        "→"  // Or UNICHAR(9679) for ●
			    )
		isHidden
		lineageTag: 7ce393b4-b097-413c-934c-1905042ef3bb

		changedProperty = IsHidden

	/// Format for VRS Input score variance visualization and analytical interpretation.
	measure VRS_Label =
			
			VAR Arrow = [VRS_Trend]
			VAR Delta = [VRS_Delta]
			RETURN
			    IF(
			    NOT ISBLANK(Delta),
			    Arrow & " " & FORMAT(Delta, "+0.0%;-0.0%;0.0%"),
			    "0%"
			)
		lineageTag: 3c938b92-fa30-42d6-88f2-3cafa2ca2dd4

	/// Format for State Ranking visualization and analytical interpretation.
	measure RankStringEstadual = ```
			
			VAR CurrentState = SELECTEDVALUE('public DEA_python'[state_name])
			VAR CurrentRank = SELECTEDVALUE('public DEA_python'[state_rank_vrs])
			VAR CheckField = SELECTEDVALUE('public DEA_python'[DEA_vrs_input])
			
			VAR TotalInState = 
			    IF(
			        NOT ISBLANK(CurrentState),
			        CALCULATE(
			            COUNTROWS('public DEA_python'),
			            FILTER(
			                ALL('public DEA_python'),
			                'public DEA_python'[year] = SELECTEDVALUE('public DEA_python'[year]) &&
			                'public DEA_python'[state_name] = CurrentState
			            )
			        ),
			        BLANK()
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(CheckField), "0 / " & TotalInState,
			        CurrentRank & " / " & TotalInState
			    )
			```
		lineageTag: 273ded80-b584-4200-8f49-19c5751cfff1

	/// Format for National Ranking visualization and analytical interpretation.
	measure RankStringNacional = ```
			
			VAR CurrentRank = SELECTEDVALUE('public DEA_python'[rank_vrs])
			VAR CheckField = SELECTEDVALUE('public DEA_python'[DEA_vrs_input]) 
			VAR Total = 
			    CALCULATE(
			        COUNTROWS('public DEA_python'),
			        ALLEXCEPT('public DEA_python', 'public DEA_python'[year])
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(CheckField), "0 / " & Total,
			        CurrentRank & " / " & Total
			    )
			```
		lineageTag: c7e4974c-d57e-4000-bc1b-98eba903ac0d

	measure VRS_Delta =
			
			VAR Base = [VRS_Base]
			VAR Latest = [VRS_Current]
			RETURN
			IF(
			    NOT ISBLANK(Base) && NOT ISBLANK(Latest) && Base <> 0,
			    DIVIDE(Latest - Base, Base)
			)
		isHidden
		lineageTag: 4ddac93f-8dac-4d87-8a7a-74f2afdfa4b0

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

