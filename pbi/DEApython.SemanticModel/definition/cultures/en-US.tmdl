cultureInfo en-US
	translations
		model Model
			table 'public DEA_python'
				caption: DEA_python
				description: Analytical dataset at the municipality-year grain used as the Decision Making Units (DMUs) for the Data Envelopment Analysis (DEA) model. Each row represents a Brazilian municipality in a specific year.
				column city_id
					caption: city_id
					description: Unique municipality (DMU) identifier (surrogate key)
				column year
					caption: year
					description =
						
						Reference year for variables.
				column city_name
					caption: city_name
					description =
						
						Official Brazilian municipality name corresponding to the DMU.
				column state_id
					caption: state_id
					description =
						
						Identifier of the state (UF) to which the municipality belongs.
				column state_name
					caption: state_name
					description =
						
						Name of the municipality's state.
				column spending_per_student
					caption: spending_per_student
					description =
						
						Annual public education expenditure per enrolled student in the municipality.
				column educ_pct_gdp
					caption: educ_pct_gdp
					description =
						
						Percentual estimado do PIB municipal destinado à educação pública.
				column DEA_vrs_input
					caption: VRS_input
					description =
						
						Technical efficiency score computed using an input-oriented DEA model under Variable Returns to Scale (VRS).
				column DEA_scale_efficiency
					caption: scale_efficiency
					description =
						
						Scale efficiency of the municipality.
				column DEA_returns_nature
					caption: returns_nature
					description =
						
						Classification of the returns to scale regime estimated by the DEA model.
				column national_median_vrs
					description =
						
						National median VRS technical efficiency score for the corresponding year.
				column state_avg_vrs
					description =
						
						State average VRS technical efficiency score for the corresponding year.
				measure VRS_Label
					description: Format for VRS Input score variance visualization and analytical interpretation.
				measure RankStringEstadual
					description: Format for State Ranking visualization and analytical interpretation.
				measure RankStringNacional
					description: Format for National Ranking visualization and analytical interpretation.
				measure EFF_Label
					description: Format for Scale Efficiency score variance visualization and analytical interpretation.
				measure NacRank_Label
					description: Format for National Ranking variance visualization and analytical interpretation.
				measure StateRank_Label
					description: Format for State Ranking variance visualization and analytical interpretation.
				measure SpendperStudent_Label
					description: Format for Spend per Student variance visualization and analytical interpretation.
				measure EducPctGDP_Label
					description: Format for Percentage of GDP spent in Education variance visualization and analytical interpretation.
				measure VRS_INPUT
					description: Format for VRS Input score visualization and analytical interpretation.
